# Salin ke apps/worker/wrangler.toml lalu ganti semua nilai placeholder.
# File wrangler.toml yang berisi ID/domain asli tidak di-commit.
name = "gapura"
main = "src/index.ts"
compatibility_date = "2026-11-01"

# Aktifkan workers.dev untuk percobaan awal. Untuk produksi, matikan dan
# gunakan custom domain di blok routes.
workers_dev = true

# routes = [
#   { pattern = "pay.example.com", custom_domain = true }
# ]

# Buat tiga database: auth (admin), sandbox, production.
# wrangler d1 create gapura-auth
[[d1_databases]]
binding = "DB_AUTH"
database_name = "gapura-auth"
database_id = "11111111-1111-1111-1111-111111111111"
migrations_dir = "migrations"

# wrangler d1 create gapura-sandbox
[[d1_databases]]
binding = "DB_SANDBOX"
database_name = "gapura-sandbox"
database_id = "22222222-2222-2222-2222-222222222222"
migrations_dir = "migrations"

# wrangler d1 create gapura-production
[[d1_databases]]
binding = "DB_PRODUCTION"
database_name = "gapura-production"
database_id = "33333333-3333-3333-3333-333333333333"
migrations_dir = "migrations"

[vars]
ENVIRONMENT = "development"
# Origin panel yang boleh memanggil /admin/*, dipisah koma.
PANEL_ORIGIN = "http://localhost:5173,http://127.0.0.1:5173"
# URL publik Worker; dipakai sebagai callbackUrl Duitku.
PUBLIC_BASE_URL = "http://127.0.0.1:8787"
DUITKU_BASE_URL = "https://sandbox.duitku.com"

[triggers]
# Pemroses retry webhook dan sinkronisasi transaksi PENDING.
crons = ["* * * * *"]
