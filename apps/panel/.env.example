# Panel Vite. Salin ke apps/panel/.env.local untuk dev atau apps/panel/.env.production saat build.
# Jangan commit file .env yang berisi nilai deployment asli.

# URL Worker API, tanpa garis miring di akhir.
VITE_API_URL=http://127.0.0.1:8787

# URL panel kanonik; dipakai halaman Dokumentasi untuk contoh.
VITE_PANEL_URL=http://127.0.0.1:5173

# Opsional: redirect host alias (mis. Pages preview) ke domain kanonik.
# Kosongkan VITE_ALIAS_HOST untuk menonaktifkan redirect.
VITE_CANONICAL_ORIGIN=
VITE_ALIAS_HOST=
