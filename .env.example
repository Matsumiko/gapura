# Salin nilai yang relevan, jangan commit file berisi nilai asli.

# Panel (apps/panel): taruh sebagai apps/panel/.env.local (sudah di-.gitignore lewat *.local).
VITE_API_URL=http://127.0.0.1:8787

# Worker (apps/worker): taruh sebagai apps/worker/.dev.vars untuk `wrangler dev`.
# Untuk produksi gunakan `wrangler secret put <NAMA>`, jangan file.
DUITKU_MERCHANT_CODE=ganti-dengan-merchant-code
DUITKU_API_KEY=ganti-dengan-api-key

# Nilai non-secret Worker (ENVIRONMENT, PANEL_ORIGIN) ada di apps/worker/wrangler.toml.

# Admin panel: CREDENTIALS_KEY dan ADMIN_SETUP_TOKEN adalah secret Worker (jangan taruh di file ini).
# Set dengan: wrangler secret put CREDENTIALS_KEY / wrangler secret put ADMIN_SETUP_TOKEN
# ADMIN_SETUP_TOKEN hanya untuk bootstrap owner pertama; hapus setelah admin_users terisi.
# PANEL_ORIGIN (non-secret) ada di apps/worker/wrangler.toml.
