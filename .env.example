# Template konfigurasi Gapura. Jangan isi nilai asli di file ini.
# Salin ke lokasi yang sesuai; semua file .env/.dev.vars diabaikan Git.

# Panel (apps/panel/.env.local untuk dev):
# VITE_API_URL=http://127.0.0.1:8787
# VITE_PANEL_URL=http://127.0.0.1:5173

# Worker saat `wrangler dev`: apps/worker/.dev.vars
# Worker produksi: gunakan `wrangler secret put <NAMA>`.
DUITKU_MERCHANT_CODE=your_merchant_code_here
DUITKU_API_KEY=your_duitku_api_key_here
CREDENTIALS_KEY=your_32_byte_base64_key_here
ADMIN_SETUP_TOKEN=your_one_time_bootstrap_token_here

# Non-secret Worker, diatur di apps/worker/wrangler.toml:
# ENVIRONMENT=development
# PANEL_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# PUBLIC_BASE_URL=http://127.0.0.1:8787
# DUITKU_BASE_URL=https://sandbox.duitku.com

# Cloudflare (opsional untuk CLI, jangan commit):
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# D1: buat tiga database lalu isi database_id di wrangler.toml:
#   wrangler d1 create gapura-auth
#   wrangler d1 create gapura-sandbox
#   wrangler d1 create gapura-production
